<article class="clearfix">
    <%- page.content %>
    <div class="footer">
        Found an error? Want to contribute?
        <a href="<%- theme.modify_github %><%- page.canonical_source %>" target="_blank">
            View this page’s source on GitHub.
        </a>
    </div>
</article>

<div class="sub-nav hiden-in-phone">
    <dl id="sub-nav">
        <dt>On this page</dt>
        <dd v-for="(ele, index) in sub_nav">
           <a v-bind:href="ele.href">{{ ele.name }}</a>
        </dd>
    </dl>
</div>
