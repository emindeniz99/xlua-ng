{
  "name": "xlua-ng-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8"
  },
  "scripts": {
    "sync": "node sync.mjs",
    "check": "node sync.mjs --check",
    "dev": "node sync.mjs && astro dev",
    "build": "node sync.mjs && astro build",
    "preview": "astro preview",
    "links": "node check-links.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.10.1"
}
