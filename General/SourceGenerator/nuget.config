<?xml version="1.0" encoding="utf-8"?>
<!-- The source generator and its tests restore from nuget.org only; the
     versions and SHA-512 hashes are pinned in each project's packages.lock.json
     (restored with locked mode by Tools/build_source_generator.py). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
