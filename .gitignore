# Native plugins are built from build/ or taken from CI artifacts.
# The .meta files next to them stay committed.
/Assets/Plugins/**/*.dll
/Assets/Plugins/**/*.so
/Assets/Plugins/**/*.a
/Assets/Plugins/**/*.dylib
/Assets/Plugins/xlua.bundle/Contents/MacOS/

# Native plugins produced by the build/make_* scripts.
/build/plugin_*/**/*.a
/build/plugin_*/**/*.so
/build/plugin_*/**/*.dll
/build/plugin_*/**/*.dylib
/build/plugin_*/**/Contents/MacOS/
__pycache__/
